import crafttweaker.event.IEventHandler;
import crafttweaker.events.IEventManager;
import mods.fluidintetweaker.event.CustomFluidBehaviorEvent;
import mods.fluidintetweaker.event.CustomFluidInteractionEvent;

zenClass IEventManager {
    
    static function onCustomFluidBehavior(manager as IEventManager, event as function(CustomFluidBehaviorEvent)void) as IEventHandler;
    
    static function onCustomFluidInteraction(manager as IEventManager, event as function(CustomFluidInteractionEvent)void) as IEventHandler;
}
