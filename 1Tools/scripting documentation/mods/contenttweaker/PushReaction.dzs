
zenClass PushReaction {
    
    static function block() as PushReaction;
    
    static function destroy() as PushReaction;
    
    static function ignore() as PushReaction;
    
    static function normal() as PushReaction;
    
    static function pushOnly() as PushReaction;
    
    operator ==(other as PushReaction) as bool;
    
    operator !=(other as PushReaction) as bool;
    
    operator >(other as PushReaction) as bool;
    
    operator >=(other as PushReaction) as bool;
    
    operator <(other as PushReaction) as bool;
    
    operator <=(other as PushReaction) as bool;
}
