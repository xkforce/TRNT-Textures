
zenClass Facing {
    
    static function down() as Facing;
    
    static function east() as Facing;
    
    static function north() as Facing;
    
    static function south() as Facing;
    
    static function up() as Facing;
    
    static function west() as Facing;
    
    operator ==(other as Facing) as bool;
    
    operator !=(other as Facing) as bool;
    
    operator >(other as Facing) as bool;
    
    operator >=(other as Facing) as bool;
    
    operator <(other as Facing) as bool;
    
    operator <=(other as Facing) as bool;
}
