import mods.contenttweaker.Material;
import mods.contenttweaker.MaterialPart;
import mods.contenttweaker.PartDataPiece;
import mods.contenttweaker.PartType;

zenClass Part {
    
    function getData() as [PartDataPiece];
    
    function getName() as string;
    
    function getOreDictPrefix() as string;
    
    function getPartType() as PartType;
    
    function getPartTypeName() as string;
    
    function getShortUnlocalizedName() as string;
    
    function getUnlocalizedName() as string;
    
    function hasOverlay() as bool;
    
    function registerToMaterial(material as Material) as MaterialPart;
    
    function registerToMaterials(materials as Material[]) as [MaterialPart];
}
