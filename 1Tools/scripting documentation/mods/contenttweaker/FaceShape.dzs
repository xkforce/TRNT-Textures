
zenClass FaceShape {
    
    static function bowl() as FaceShape;
    
    static function center() as FaceShape;
    
    static function center_big() as FaceShape;
    
    static function center_small() as FaceShape;
    
    static function middle_pole() as FaceShape;
    
    static function middle_pole_thick() as FaceShape;
    
    static function middle_pole_thin() as FaceShape;
    
    static function solid() as FaceShape;
    
    static function undefined() as FaceShape;
    
    operator ==(other as FaceShape) as bool;
    
    operator !=(other as FaceShape) as bool;
    
    operator >(other as FaceShape) as bool;
    
    operator >=(other as FaceShape) as bool;
    
    operator <(other as FaceShape) as bool;
    
    operator <=(other as FaceShape) as bool;
}
