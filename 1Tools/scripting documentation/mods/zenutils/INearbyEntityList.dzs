import crafttweaker.entity.IEntity;
import crafttweaker.entity.IEntityDefinition;
import crafttweaker.entity.IEntityItem;
import crafttweaker.entity.IEntityLivingBase;
import crafttweaker.player.IPlayer;
import mods.zenutils.IEntityPredicate;

zenClass INearbyEntityList {
    val closestEntity as IEntity;
    val closestItem as IEntityItem;
    val closestLiving as IEntityLivingBase;
    val closestPlayer as IPlayer;
    val entities as [IEntity];
    val items as [IEntityItem];
    val livings as [IEntityLivingBase];
    val players as [IPlayer];
    
    function closestEntity() as IEntity;
    
    function closestItem() as IEntityItem;
    
    function closestLiving() as IEntityLivingBase;
    
    function closestPlayer() as IPlayer;
    
    function entities() as [IEntity];
    
    function filter(predicate as IEntityPredicate) as INearbyEntityList;
    
    function filterType(definition as IEntityDefinition) as INearbyEntityList;
    
    function items() as [IEntityItem];
    
    function livings() as [IEntityLivingBase];
    
    function players() as [IPlayer];
}
