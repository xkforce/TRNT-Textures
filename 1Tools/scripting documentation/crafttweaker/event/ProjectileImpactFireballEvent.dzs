import crafttweaker.event.IEventCancelable;
import crafttweaker.event.ProjectileImpactEvent;

zenClass ProjectileImpactFireballEvent extends IEventCancelable, ProjectileImpactEvent {
    var accelerationX as double;
    var accelerationY as double;
    var accelerationZ as double;
    val fireball as IEntity;
    val shooter as IEntityLivingBase;
}
