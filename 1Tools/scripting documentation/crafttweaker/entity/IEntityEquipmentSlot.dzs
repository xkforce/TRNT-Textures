
zenClass IEntityEquipmentSlot {
    val index as int;
    val name as string;
    val slotIndex as int;
    
    static function chest() as IEntityEquipmentSlot;
    
    static function feet() as IEntityEquipmentSlot;
    
    static function head() as IEntityEquipmentSlot;
    
    static function legs() as IEntityEquipmentSlot;
    
    static function mainHand() as IEntityEquipmentSlot;
    
    static function offhand() as IEntityEquipmentSlot;
    
    operator ==(other as IEntityEquipmentSlot) as bool;
    
    operator !=(other as IEntityEquipmentSlot) as bool;
    
    operator >(other as IEntityEquipmentSlot) as bool;
    
    operator >=(other as IEntityEquipmentSlot) as bool;
    
    operator <(other as IEntityEquipmentSlot) as bool;
    
    operator <=(other as IEntityEquipmentSlot) as bool;
}
